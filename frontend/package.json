{
  "name": "lila-local-rag-ui-demo",
  "version": "0.1.0",
  "description": "Offline source-grounded document assistant powered by Foundry Local",
  "author": "Kardelen Tumay",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "npm run desktop:build && electron electron/main.cjs",
    "desktop:backend": "powershell -ExecutionPolicy Bypass -File ../backend/build-desktop.ps1",
    "desktop:package": "npm run desktop:backend && npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.nivora.localrag",
    "productName": "Nivora",
    "artifactName": "Nivora-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/local-rag-api.exe",
        "to": "backend/local-rag-api.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "public/assistant-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
